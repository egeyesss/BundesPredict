# FastAPI service. Build context is the repo root (a uv workspace: needs packages/ + apps/).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# Third-party deps first for layer caching. uv reads every workspace member's
# pyproject to resolve, so all of them are copied even though only the API is installed.
COPY pyproject.toml uv.lock ./
COPY packages/model/pyproject.toml packages/model/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
# The API serves the fitted model and the agent, so bundespredict[model,agent] comes along.
RUN uv sync --frozen --no-dev --no-install-workspace --package bundespredict-api

COPY packages/model packages/model
COPY apps/api apps/api
RUN uv sync --frozen --no-dev --package bundespredict-api

EXPOSE 8000
# Shell form so a host-injected PORT (Railway and friends) wins over the default.
CMD uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port ${PORT:-8000}
