# Django service under uvicorn (ASGI). Build context is the repo root.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=config.settings.prod

COPY pyproject.toml uv.lock ./
COPY packages/model/pyproject.toml packages/model/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY apps/backend/pyproject.toml apps/backend/pyproject.toml
RUN uv sync --frozen --no-dev --no-install-workspace --package bundespredict-backend

COPY packages/model packages/model
COPY apps/backend apps/backend
RUN uv sync --frozen --no-dev --package bundespredict-backend

# Collects the admin's static files for whitenoise. The prod settings insist on real-looking
# values, but collectstatic never reads them.
RUN DJANGO_SECRET_KEY=build DJANGO_ALLOWED_HOSTS=localhost PROXY_SECRET=build \
    DATABASE_URL=postgresql://build:build@localhost/build \
    python apps/backend/manage.py collectstatic --noinput

EXPOSE 8001
CMD uvicorn config.asgi:application --app-dir apps/backend --host 0.0.0.0 --port ${PORT:-8001}
